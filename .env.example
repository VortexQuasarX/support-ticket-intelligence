# Optional: Groq Cloud API Key (Free tier: https://console.groq.com)
# When set, the system uses LLaMA 3.3 70B for ultra-fast, high-precision Text-to-SQL.
GROQ_API_KEY=

# Optional: Local Ollama URL (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# LLM Provider selection: auto | groq | ollama | fallback
LLM_PROVIDER=auto

# Server settings
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501

# Anomaly Detection SLA Thresholds (Hours)
SLA_CRITICAL_HOURS=12.0
SLA_HIGH_HOURS=24.0
SLA_MEDIUM_HOURS=48.0
MAX_RESPONSE_TIME_THRESHOLD=4.0
